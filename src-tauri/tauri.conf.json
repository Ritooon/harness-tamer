{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarnessForge",
  "version": "0.1.0",
  "identifier": "io.github.ritooon.harnessforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "form-action": "'none'",
        "base-uri": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AGENTS.md et skills pour agents de code, générés hors ligne",
    "longDescription": "HarnessForge génère des fichiers AGENTS.md et des skills pour agents de code avec un modèle de langage local. Aucune donnée ne quitte la machine ; tout accès à Internet est demandé, confirmé et journalisé.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/llama/": "llama/"
    },
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
