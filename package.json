{
  "name": "harnessforge",
  "private": true,
  "version": "0.1.0",
  "description": "Génère AGENTS.md et skills pour agents de code, avec un modèle de langage local.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "bindings": "cargo test -p hf-engine --features ts export_bindings",
    "check:network": "node scripts/check-network-deps.mjs",
    "fetch:llama": "node scripts/fetch-llama.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "codemirror": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
